# Lightweight image for registering NeMo Evaluator targets and configs.
#
# Build example:
#   docker build -f deploy/evaluator-registration/Containerfile -t docs-to-data-to-lora/evaluator-registration:latest .
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

RUN pip install --no-cache-dir httpx

WORKDIR /app
COPY scripts/nemo_platform.py /app/scripts/nemo_platform.py
COPY scripts/eval /app/scripts/eval

ENTRYPOINT ["python", "scripts/eval/register_evaluator_entities.py"]
