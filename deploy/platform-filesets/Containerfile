# Lightweight image for uploading finalized datasets to NeMo Platform FileSets.
#
# Build example:
#   docker build -f deploy/platform-filesets/Containerfile -t docs-to-data-to-lora/platform-filesets:latest .
FROM python:3.12-slim

ARG NEMO_PLATFORM_REQUIREMENTS=""

ENV PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1     PYTHONPATH=/app

RUN pip install --no-cache-dir httpx pydantic     && if [ -n "$NEMO_PLATFORM_REQUIREMENTS" ]; then          pip install --no-cache-dir $NEMO_PLATFORM_REQUIREMENTS;        fi

WORKDIR /app
COPY scripts /app/scripts

ENTRYPOINT ["python", "scripts/eval/upload_platform_filesets.py"]
