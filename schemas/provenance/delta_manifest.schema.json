{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs-to-data-to-lora.local/schemas/provenance/delta_manifest.schema.json",
  "title": "DeltaManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delta_manifest_id",
    "base_crawl_run_id",
    "new_crawl_run_id",
    "summary",
    "urls",
    "entailments"
  ],
  "properties": {
    "schema_version": {
      "const": "provenance.v1"
    },
    "delta_manifest_id": {
      "type": "string",
      "pattern": "^delta_[A-Za-z0-9_.:-]+$"
    },
    "base_crawl_run_id": {
      "type": "string"
    },
    "new_crawl_run_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "changed", "unchanged", "deleted", "redirected", "failed", "excluded"],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "integer",
          "minimum": 0
        },
        "redirected": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "urls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "deleted": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "redirected": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "default": []
        }
      }
    },
    "entailments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires_revalidation": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "superseded": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "retracted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "new": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "rebuild_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "default": []
    }
  }
}
