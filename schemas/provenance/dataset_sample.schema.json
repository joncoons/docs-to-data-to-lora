{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs-to-data-to-lora.local/schemas/provenance/dataset_sample.schema.json",
  "title": "DatasetSample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "origin",
    "task_type",
    "prompt",
    "completion",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "provenance.v1"
    },
    "sample_id": {
      "type": "string",
      "pattern": "^sample_[A-Za-z0-9_.:-]+$"
    },
    "origin": {
      "type": "string",
      "enum": [
        "source_entailed",
        "synthetic_gapfill",
        "human_reviewed",
        "imported_baseline"
      ]
    },
    "task_type": {
      "type": "string",
      "enum": [
        "qa",
        "summary",
        "listicle",
        "procedural",
        "bridging",
        "contrastive",
        "rag_eval",
        "other"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "completion": {
      "type": "string"
    },
    "system": {
      "type": [
        "string",
        "null"
      ]
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entailment_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_revision_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_chunk_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "gap_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_designer_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "seed_sample_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_systems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "source_kinds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "curator_job_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "judge_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "grounding_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "origin": {
            "const": "source_entailed"
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "required": [
              "entailment_ids",
              "source_revision_ids"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "synthetic_gapfill"
          }
        }
      },
      "then": {
        "properties": {
          "lineage": {
            "required": [
              "gap_id",
              "data_designer_job_id"
            ]
          }
        }
      }
    }
  ]
}
